---
export const prerender = true

import Base from '../layouts/Base.astro'
import InviteRedirect from '../components/InviteRedirect.astro'
import Nav from '../components/Nav.astro'
import Hero from '../components/Hero.tsx'
import Features from '../components/Features.astro'
import HowItWorks from '../components/HowItWorks.astro'
import Gallery from '../components/Gallery.tsx'
import TestCta from '../components/TestCta.tsx'
import FeedbackForm from '../components/FeedbackForm.tsx'
import Footer from '../components/Footer.astro'
---

<Base
  title="Meu Cuidado — Lembretes de remédios para você e quem você cuida"
  description="Organize doses, horários e lembretes de medicamentos para dependentes e compartilhe o cuidado com outros cuidadores em um só app."
>
  <InviteRedirect />
  <main class="landing">
    <div class="hero-shell">
      <Nav />
      <Hero client:load />
    </div>
    <Features />
    <HowItWorks />
    <Gallery client:visible />
    <TestCta client:visible />
    <FeedbackForm client:visible />
    <Footer />
  </main>
</Base>

<style>
  .landing {
    padding: var(--space-16);
  }

  .hero-shell {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    background: radial-gradient(120% 90% at 85% 8%, #1a7d6b 0%, var(--teal) 40%, var(--deep) 100%);
  }

  @media (min-width: 720px) {
    .landing {
      padding: var(--space-24);
    }
  }
</style>
