---
interface Props {
  sticky?: boolean
}

const { sticky = false } = Astro.props
---

<nav class:list={['nav', { 'nav--sticky': sticky }]}>
  <div class="nav__brand">
    <img src="/brand/glifo-branco.png" alt="Meu Cuidado" width="34" height="34" />
    <span>Meu Cuidado</span>
  </div>
  <a class="nav__cta" href="#testar">Participar do teste</a>
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    padding: 22px 40px;
    position: relative;
    z-index: 3;
    color: #fff;
  }

  .nav--sticky {
    position: sticky;
    top: 0;
  }

  .nav--sticky.nav--scrolled {
    background: rgba(10, 63, 56, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.3px;
  }

  .nav__brand img {
    width: 34px;
    height: 34px;
  }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    font-weight: 700;
    font-size: 14px;
    padding: 10px 18px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
    transition: background 0.2s ease;
  }

  .nav__cta:hover,
  .nav__cta:focus-visible {
    background: rgba(255, 255, 255, 0.14);
  }

  .nav__cta:focus-visible,
  .nav__brand:focus-visible {
    outline: 2px solid var(--mint);
    outline-offset: 2px;
  }

  @media (max-width: 720px) {
    .nav {
      padding: 18px 20px;
    }

    .nav__brand span {
      font-size: 17px;
    }

    .nav__cta {
      padding: 9px 14px;
      font-size: 13px;
    }
  }
</style>

{
  sticky && (
    <script>
      const nav = document.querySelector('.nav--sticky')
      if (nav) {
        const onScroll = () => {
          nav.classList.toggle('nav--scrolled', window.scrollY > 8)
        }
        onScroll()
        window.addEventListener('scroll', onScroll, { passive: true })
      }
    </script>
  )
}
