---
const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="footer__inner">
    <p class="footer__brand">© {year} Meu Cuidado</p>
    <nav class="footer__links" aria-label="Links do rodapé">
      <a href="/politica-de-privacidade/">Política de Privacidade</a>
      <a href="/exclusao-de-conta/">Exclusão de conta</a>
      <a href="mailto:abisaytech@gmail.com">Contato</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    background: var(--deep);
    color: var(--mint-l);
    margin-top: var(--space-64);
    border-radius: 18px;
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    padding: var(--space-24);
  }

  .footer__brand {
    margin: 0;
    font-size: 14px;
    color: var(--mint-l);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-24);
  }

  .footer__links a {
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer__links a:hover {
    color: var(--mint);
  }

  .footer__links a:focus-visible {
    outline: 2px solid var(--mint);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (max-width: 640px) {
    .footer__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
