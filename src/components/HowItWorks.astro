---
import Reveal from './Reveal.tsx'

const steps = [
  {
    number: '1',
    title: 'Cadastra o remédio',
    text: 'Nome, dose e horário — em poucos toques o remédio já está na agenda.',
    icon: 'pill',
  },
  {
    number: '2',
    title: 'Recebe o lembrete',
    text: 'Uma notificação avisa na hora certa, sem depender da memória.',
    icon: 'bell',
  },
  {
    number: '3',
    title: 'Marca como tomado',
    text: 'Um toque confirma a dose e mantém o histórico sempre em dia.',
    icon: 'check',
  },
]
---

<section class="how" id="como-funciona" aria-labelledby="how-title">
  <div class="how__intro">
    <h2 id="how-title">Como funciona</h2>
    <p>Três passos simples para nunca mais esquecer um remédio.</p>
  </div>

  <div class="how__steps">
    {
      steps.map((step, i) => (
        <Reveal client:visible delay={i * 0.1}>
          <div class="step">
            <div class="step__icon" aria-hidden="true">
              {step.icon === 'pill' && (
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect
                    x="3.5"
                    y="9.5"
                    width="17"
                    height="8"
                    rx="4"
                    transform="rotate(-35 12 13.5)"
                    stroke="currentColor"
                    stroke-width="1.8"
                  />
                  <path d="M10.3 11.3 13.7 14.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              )}
              {step.icon === 'bell' && (
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M6 10a6 6 0 1 1 12 0c0 4 1.5 5.5 1.5 5.5H4.5S6 14 6 10Z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                  />
                  <path d="M10 18.5a2 2 0 0 0 4 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              )}
              {step.icon === 'check' && (
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8" />
                  <path
                    d="M8.5 12.3 11 14.8 15.5 9.7"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              )}
            </div>
            <span class="step__number" aria-hidden="true">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </Reveal>
      ))
    }
  </div>
</section>

<style>
  .how {
    padding: var(--space-64) 0;
  }

  .how__intro {
    max-width: 560px;
    margin: 0 auto var(--space-40);
    text-align: center;
  }

  .how__intro h2 {
    font-weight: 800;
    font-size: 32px;
    letter-spacing: -0.8px;
    margin: 0 0 var(--space-12);
    color: var(--deep);
  }

  .how__intro p {
    font-weight: 500;
    font-size: 16px;
    color: var(--ink);
    opacity: 0.75;
    margin: 0;
  }

  .how__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-24);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    position: relative;
    background: var(--cream);
    border: 1px solid var(--mint-l);
    border-radius: 18px;
    padding: var(--space-24);
    text-align: center;
  }

  .step__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--teal);
    color: var(--mint);
    margin-bottom: var(--space-16);
  }

  .step__icon svg {
    width: 26px;
    height: 26px;
  }

  .step__number {
    position: absolute;
    top: var(--space-16);
    right: var(--space-16);
    font-weight: 800;
    font-size: 13px;
    color: var(--teal);
    opacity: 0.5;
  }

  .step h3 {
    font-weight: 800;
    font-size: 18px;
    letter-spacing: -0.3px;
    margin: 0 0 var(--space-8);
    color: var(--deep);
  }

  .step p {
    font-weight: 500;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink);
    opacity: 0.75;
    margin: 0;
  }

  @media (max-width: 720px) {
    .how__steps {
      grid-template-columns: 1fr;
    }

    .how__intro h2 {
      font-size: 26px;
    }
  }
</style>
